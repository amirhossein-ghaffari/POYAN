<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - پویان</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="top-nav">
        <a class="brand" asp-page="/Index"><span class="brand-mark">P</span> پویان</a>
        <div class="nav-links">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-page="/Dashboard/Index">داشبورد</a>
                <a asp-page="/Students/Index">دانش‌آموزان</a>
                <form method="post" asp-area="Identity" asp-page="/Account/Logout" class="logout-form">
                    <button type="submit" class="nav-logout">خروج</button>
                </form>
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Login">ورود</a>
            }
        </div>
    </nav>
    <main>@RenderBody()</main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
